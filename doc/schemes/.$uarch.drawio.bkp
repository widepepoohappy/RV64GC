          <mxGeometry x="55" y="255.98459477561954" width="23.57142857142857" height="16.79839249832552" as="geometry" />
        </mxCell>
        <mxCell id="y5xzyNHOv3AjmiNJnoz2-234" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;i&gt;0&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=10;" parent="MQ5YCEGSpXZeGLRsvfkm-73" vertex="1">
          <mxGeometry x="78.57142857142857" y="255.98459477561954" width="23.57142857142857" height="16.79839249832552" as="geometry" />
        </mxCell>
        <mxCell id="y5xzyNHOv3AjmiNJnoz2-235" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;i&gt;0&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=10;" parent="MQ5YCEGSpXZeGLRsvfkm-73" vertex="1">
